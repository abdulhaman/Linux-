-- ==============================================
-- 2. Testing Modern macOS API
-- ==============================================
local Window = library:MakeWindow({
    Title = "Karpiware 6.1.0",
    SubTitle = "Build - Paid (Stable) | Universal"
})

Window:AddMinimizeButton({
    Button = { Image = "rbxassetid://71014873973869", BackgroundTransparency = 0 },
    Corner = { CornerRadius = UDim.new(0.5, 0) },
})

local Tab1 = Window:MakeTab({"Ragebot", "icon_here"})

Tab1:AddDiscordInvite({
    Name = "Ragebot Hub",
    Description = "Join server for configs",
    Logo = "rbxassetid://18751483361",
    Invite = "https://discord.gg/example",
})

Window:SelectTab(Tab1)

local Section1 = Tab1:AddSection({"Main Settings"})

Section1:AddToggle({
    Name = "Master switch",
    Default = true,
    Callback = function(v)
        print("Master switch:", v)
    end
})

Section1:AddToggle({
    Name = "Silent aim",
    Default = false,
    Callback = function(v) end
})

Section1:AddSlider({
    Name = "Field of view",
    Min = 0,
    Max = 360,
    Increase = 1,
    Default = 180,
    Callback = function(Value)
        print("FOV:", Value)
    end
})

local Section2 = Tab1:AddSection({"Extra Features"})

Section2:AddSlider({
    Name = "Minimum damage",
    Min = 0,
    Max = 100,
    Increase = 1,
    Default = 39,
    Callback = function(Value) end
})

Section2:AddDropdown({
    Name = "Hitboxes...",
    Options = {"Head", "Torso", "Arms", "Legs", "All"},
    Default = "Head",
    Callback = function(Value)
        print("Hitbox selected:", Value)
    end
})

Section2:AddTextBox({
    Name = "Force conditions",
    PlaceholderText = "Enter conditions...",
    Callback = function(Value)
        print("Conditions:", Value)
    end
})

Section2:AddParagraph({
    Name = "Note",
    Text = "This is a sleek premium typography test."
})

Section2:AddButton({"Open Dialog", function()
    Window:Dialog({
        Title = "Danger",
        Text = "Are you sure you want to proceed?",
        Options = {
            {"Confirm", function() print("Confirmed!") end},
            {"Cancel", function() print("Canceled!") end}
        }
    })
end})
